{% extends 'base.html.twig' %}

{% block title %}Créer une génération{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="fas fa-plus me-2"></i>Créer une nouvelle génération</h4>
                <div class="text-white-50 mt-2">Ajoutez une génération à votre arbre généalogique</div>
            </div>
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold" for="{{ form.generationName.vars.id }}">Nom de la génération <span class="text-danger">*</span></label>
                            {{ form_widget(form.generationName, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Ancêtres, Parents, Enfants...', 'required': 'required'}}) }}
                            {{ form_errors(form.generationName) }}
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold" for="{{ form.displayOrder.vars.id }}">Ordre d'affichage <span class="text-danger">*</span></label>
                            {{ form_widget(form.displayOrder, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                            {{ form_errors(form.displayOrder) }}
                            <small class="text-muted">0 = tout en haut, augmentez pour descendre dans l'arbre.</small>
                        </div>
                    </div>

                    <div class="mt-5 d-flex gap-2 justify-content-between">
                        <a href="{{ path('generations_list') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Annuler
                        </a>
                        {{ form_widget(form.save, {'attr': {'class': 'btn btn-success btn-lg'}}) }}
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
